<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Reconciliation report</title>
<style>
:root { --bg: #ffffff; --fg: #1f2328; --muted: #59636e; --line: #d1d9e0; --bad: #cf222e; --ok: #1a7f37; --head: #f6f8fa; }
@media (prefers-color-scheme: dark) { :root { --bg: #0d1117; --fg: #e6edf3; --muted: #9198a1; --line: #3d444d; --bad: #f85149; --ok: #3fb950; --head: #151b23; } }
body { margin: 0; padding: 24px 16px; background: var(--bg); color: var(--fg); font: 15px/1.5 -apple-system, "Segoe UI", Helvetica, Arial, sans-serif; }
main { max-width: 1100px; margin: 0 auto; }
h1 { font-size: 24px; margin: 0 0 4px; }
h2 { font-size: 18px; margin: 32px 0 8px; }
.muted { color: var(--muted); }
.summary { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 16px; }
.tile { border: 1px solid var(--line); border-radius: 8px; padding: 10px 14px; min-width: 130px; }
.tile b { display: block; font-size: 22px; }
.tile.bad b { color: var(--bad); }
.tile.ok b { color: var(--ok); }
.scroll { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-size: 14px; table-layout: fixed; min-width: 720px; }
td code { word-break: break-all; }
th, td { text-align: left; padding: 6px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
th { background: var(--head); font-weight: 600; }
td.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
code { font: 13px ui-monospace, SFMono-Regular, Menlo, monospace; }
</style>
</head>
<body>
<main>
<h1>Reconciliation report</h1>
<p class="muted">recon {{.Version}}{{if .GeneratedAt}} &middot; {{.GeneratedAt}}{{end}}</p>

<div class="summary">
  <div class="tile ok"><b>{{.Matched}}</b>reconciled</div>
  {{range .Counts}}<div class="tile{{if .Count}} bad{{end}}"><b>{{.Count}}</b>{{label .Category}}</div>
  {{end}}
</div>

{{$diffs := .Differences}}
{{range .Counts}}{{if .Count}}
<h2>{{label .Category}} ({{.Count}})</h2>
<div class="scroll"><table>
<colgroup><col style="width:26%"><col style="width:16%"><col style="width:16%"><col style="width:12%"><col style="width:30%"></colgroup>
<tr><th>Key</th><th>Ledger</th><th>Provider</th><th>Difference</th><th>Rows</th></tr>
{{range of $diffs .Category}}<tr>
<td><code>{{join .Key " | "}}</code></td>
<td class="num">{{with .Ledger}}{{with .Amount}}{{.Decimal}}{{end}} {{.Currency}}{{with .Fee}}<br><span class="muted">fee {{.Decimal}}</span>{{end}}{{else}}&mdash;{{end}}</td>
<td class="num">{{with .Provider}}{{with .Amount}}{{.Decimal}}{{end}} {{.Currency}}{{with .Fee}}<br><span class="muted">fee {{.Decimal}}</span>{{end}}{{else}}&mdash;{{end}}</td>
<td class="num">{{with .Delta}}{{.Decimal}}{{end}}</td>
<td><code>{{with .Ledger}}{{join .Rows " "}}{{end}}{{if and .Ledger .Provider}}<br>{{end}}{{with .Provider}}{{join .Rows " "}}{{end}}</code></td>
</tr>
{{end}}</table></div>
{{end}}{{end}}

<h2>Inputs</h2>
<div class="scroll"><table>
<tr><th>Side</th><th>Source</th><th>Rows</th><th>SHA-256</th></tr>
{{range .Inputs.Ledger}}<tr><td>ledger</td><td><code>{{.Name}}</code></td><td class="num">{{.Rows}}</td><td><code>{{.SHA256}}</code></td></tr>
{{end}}{{range .Inputs.Provider}}<tr><td>provider</td><td><code>{{.Name}}</code></td><td class="num">{{.Rows}}</td><td><code>{{.SHA256}}</code></td></tr>
{{end}}</table></div>
</main>
</body>
</html>
